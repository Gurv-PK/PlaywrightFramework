pipeline{
    agent any
    tools{
        nodejs 'node18'
    }
    environment {
        AWS_DEFAULT_REGION = 'us-east-1'
        S3_BUCKET = 'playwright-test-reportsci'
    }
    stages{
        stage('checkout'){
            steps{
                checkout scm
            }
        }
        stage('Install dependencies') {
            steps{
                sh 'npm ci'
                sh 'npx playwright install --with-deps'
            }
        }
        stage('Run tests') {
            steps{
                sh 'npx playwright test'
            }
        }
        stage('Archive Reports') {
            steps{
                archiveArtifacts artifacts: 'playwright-report/**', fingerprint: true
            }
        }
        stage('Upload to s3') {
            steps{
                    sh '''
                        aws s3 sync playwright-report/ s3://$S3_BUCKET/build-$BUILD_NUMBER/playwright-report/
                        aws s3 sync test-results/ s3://$S3_BUCKET/build-$BUILD_NUMBER/test-results/
                        '''
            }
        }
    }
}