pipeline{
    agent any
    tools{
        nodejs 'node18'
    }
    environment {
        AWS_DEFAULT_REGION = 'us-east-1'
        S3_BUCKET = 'playwright-test-reportsci'
    }
    stages{
        stage('checkout'){
            steps{
                checkout scm
            }
        }
       
        stage('Build and Push Docker Images') {
            steps{
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhubcreds',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                    echo "--- Checking current directory ---"
                        pwd
                        ls -F
                    echo "----------------------------------"
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                        docker build -t $DOCKER_USER/playwright-test:$BUILD_NUMBER .
                        docker push $DOCKER_USER/playwright-test:$BUILD_NUMBER
                        '''
                }
            }
        }
        stage('Run tests on Kubernetes') {
            steps{
                sh '''
                    kubectl delete job playwright-tests --ignore-not-found
                    sed -i "s/__BUILD_NUMBER__/$BUILD_NUMBER/g" batch.yaml
                    kubectl apply -f batch.yaml
                '''
            }
        }

        stage('Wait for Kubernetes Job') {
            steps {
                sh '''
                  kubectl wait --for=condition=complete job/playwright-tests --timeout=600s || \
                  kubectl wait --for=condition=failed job/playwright-tests --timeout=1s

                  if ! kubectl wait --for=condition=complete job/playwright-tests --timeout=600s; then
                    echo "Job failed. Dumping logs..."
                    kubectl logs job/playwright-tests --all-containers=true
                    exit 1
                fi
                '''
            }
        }

        stage('Fetch logs of Kubernetes') {
            steps{
                sh 'kubectl logs job/playwright-tests'
            }
        }

        // Not required as added uploading of reports directly from pod 
        // stage('Upload to s3') {
        //     steps{
        //             sh '''
        //                 aws s3 sync playwright-report/ s3://$S3_BUCKET/build-$BUILD_NUMBER/playwright-report/
        //                 aws s3 sync test-results/ s3://$S3_BUCKET/build-$BUILD_NUMBER/test-results/
        //                 '''
        //     }
        // }
    }
    post {
        always{
            cleanWs()
        }
    }
}